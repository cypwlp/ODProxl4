<UserControl
    x:Class="ODProxl.Dialogs.ModelClassDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="760"
    d:DesignWidth="1280"
    mc:Ignorable="d">
	<UserControl.Styles>
		<Style Selector="DataGrid">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="GridLinesVisibility" Value="None" />
			<Setter Property="RowBackground" Value="Transparent" />
			<Setter Property="CornerRadius" Value="8" />
		</Style>
		<Style Selector="DataGridColumnHeader">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource MaterialForegroundBrush}" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="FontSize" Value="13.5" />
			<Setter Property="Padding" Value="16,12" />
			<Setter Property="BorderBrush" Value="{DynamicResource MaterialDividerBrush}" />
			<Setter Property="BorderThickness" Value="0,0,0,1" />
		</Style>
		<Style Selector="DataGridRow">
			<Setter Property="MinHeight" Value="52" />
		</Style>
		<Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
			<Setter Property="Fill" Value="{DynamicResource MaterialPrimaryLightBrush}" />
			<Setter Property="Opacity" Value="0.12" />
		</Style>
		<Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
			<Setter Property="Fill" Value="{DynamicResource MaterialHoverBackgroundBrush}" />
		</Style>
		<Style Selector="DataGridCell">
			<Setter Property="Padding" Value="16,10" />
			<Setter Property="FontSize" Value="13.5" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
	</UserControl.Styles>

	<Border
        Margin="20"
        Padding="24"
        Background="{DynamicResource MaterialCardBackgroundBrush}"
        BoxShadow="0 10 32 0 #1A000000"
        CornerRadius="16">
		<Grid RowDefinitions="Auto, *, *">

			<!--  標題 + 搜尋 + 按鈕  -->
			<Grid Grid.Row="0" Margin="0,0,0,20">
				<StackPanel Orientation="Horizontal" Spacing="12">
					<avalonia:MaterialIcon
                        Width="32"
                        Height="32"
                        Foreground="{DynamicResource MaterialPrimaryBrush}"
                        Kind="FolderTable" />
					<StackPanel VerticalAlignment="Center" Spacing="4">
						<TextBlock
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource MaterialForegroundBrush}"
                            Text="模型類別管理" />
						<TextBlock
                            FontSize="14"
                            Foreground="{DynamicResource MaterialSecondaryForegroundBrush}"
                            Text="管理基底與子模型分類" />
					</StackPanel>
				</StackPanel>

				<StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
					<TextBox
                        Width="420"
                        Height="46"
                        Classes="solo"
                        CornerRadius="999"
                        Text="{Binding SearchText, Mode=TwoWay}"
                        Watermark="搜尋類別名稱或 ID...">
						<TextBox.InnerLeftContent>
							<avalonia:MaterialIcon
                                Width="22"
                                Height="22"
                                Margin="16,0,0,0"
                                Kind="Magnify" />
						</TextBox.InnerLeftContent>
					</TextBox>
					<Button
                        Padding="16,8"
                        Classes="flat"
                        Command="{Binding AddBaseClassCommand}"
                        CornerRadius="8">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<avalonia:MaterialIcon
                                Width="20"
                                Height="20"
                                Kind="Plus" />
							<TextBlock Text="新增基底類別" />
						</StackPanel>
					</Button>
					<Button
                        Padding="16,8"
                        Classes="flat"
                        Command="{Binding AddSubClassCommand}"
                        CornerRadius="8">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<avalonia:MaterialIcon
                                Width="20"
                                Height="20"
                                Kind="PlusCircleOutline" />
							<TextBlock Text="新增子類別" />
						</StackPanel>
					</Button>
				</StackPanel>
			</Grid>

			<!--  基底模型類別  -->
			<Grid
                Grid.Row="1"
                Margin="0,0,0,6"
                RowDefinitions="Auto,*">
				<TextBlock
                    Grid.Row="0"
                    Margin="4,0,0,8"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource MaterialForegroundBrush}"
                    Text="基底模型類別" />
				<Border
                    Grid.Row="1"
                    Background="{DynamicResource MaterialPaperBrush}"
                    BorderBrush="{DynamicResource MaterialDividerBrush}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="12">
					<DataGrid
                        AutoGenerateColumns="False"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="True"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding FilteredBaseClasses}"
                        SelectedItem="{Binding SelectedBaseClass, Mode=TwoWay}">
						<DataGrid.Columns>
							<DataGridTextColumn
                                Width="70"
                                Binding="{Binding ClassSuffix}"
                                Header="序號" />
							<DataGridTextColumn
                                Width="80"
                                Binding="{Binding ClassId}"
                                Header="ID" />
							<DataGridTextColumn
                                Width="220"
                                Binding="{Binding ClassName}"
                                Header="類別名稱" />
							<DataGridTextColumn
                                Width="140"
                                Binding="{Binding ClassType}"
                                Header="類型" />
							<DataGridTextColumn
                                Width="160"
                                Binding="{Binding CreateTime, StringFormat='yyyy-MM-dd HH:mm'}"
                                Header="創建時間" />
							<DataGridTextColumn
                                Width="160"
                                Binding="{Binding ModifyTime, StringFormat='yyyy-MM-dd HH:mm'}"
                                Header="修改時間" />
							<DataGridTextColumn
                                Width="100"
                                Binding="{Binding IsEnabled}"
                                Header="狀態" />
						</DataGrid.Columns>
					</DataGrid>
				</Border>
			</Grid>

			<!--  子模型類別  -->
			<Grid
                Grid.Row="2"
                Margin="0,6,0,0"
                RowDefinitions="Auto,*">
				<TextBlock
                    Grid.Row="0"
                    Margin="4,0,0,8"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource MaterialForegroundBrush}"
                    Text="子模型類別" />
				<Border
                    Grid.Row="1"
                    Background="{DynamicResource MaterialPaperBrush}"
                    BorderBrush="{DynamicResource MaterialDividerBrush}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="12">
					<DataGrid
                        AutoGenerateColumns="False"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="True"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding FilteredSubClasses}">
						<DataGrid.Columns>
							<DataGridTextColumn
                                Width="70"
                                Binding="{Binding ClassSuffix}"
                                Header="序號" />
							<DataGridTextColumn
                                Width="220"
                                Binding="{Binding ClassName}"
                                Header="類別名稱" />
							<DataGridTextColumn
                                Width="140"
                                Binding="{Binding ClassType}"
                                Header="類型" />
							<DataGridTextColumn
                                Width="160"
                                Binding="{Binding CreateTime, StringFormat='yyyy-MM-dd HH:mm'}"
                                Header="創建時間" />
							<DataGridTextColumn
                                Width="160"
                                Binding="{Binding ModifyTime, StringFormat='yyyy-MM-dd HH:mm'}"
                                Header="修改時間" />
							<DataGridTextColumn
                                Width="100"
                                Binding="{Binding IsEnabled}"
                                Header="狀態" />
						</DataGrid.Columns>
					</DataGrid>
				</Border>
			</Grid>

		</Grid>
	</Border>
</UserControl>