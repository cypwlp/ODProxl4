<UserControl
    x:Class="ODProxl.Dialogs.ReviseRuleClassDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:ODProxl.ViewModels.Dialogs;assembly=ODProxl.ViewModels"
    Width="600"
    Height="450"
    d:DesignHeight="450"
    d:DesignWidth="600"
    x:DataType="vm:ReviseRuleClassDialogViewModel"
    mc:Ignorable="d">
	<Border
        Padding="40,32"
        Background="{DynamicResource MaterialSurfaceColor}"
        BoxShadow="0 12 40 0 #33000000"
        CornerRadius="28">
		<StackPanel Spacing="28">
			<TextBox
                MinHeight="52"
                Padding="16,14"
                Classes="Filled"
                CornerRadius="16"
                FontSize="16"
                MaxLines="1"
                Text="{Binding RuleClassName, Mode=TwoWay}"
                Watermark="類別名稱" />
			<TextBox
                MinHeight="52"
                Padding="16,14"
                Classes="Filled"
                CornerRadius="16"
                FontSize="16"
                MaxLines="1"
                Text="{Binding RuleClassKey, Mode=TwoWay}"
                Watermark="類別鍵名" />

			<Panel
                Width="170"
                Height="170"
                HorizontalAlignment="Left">

				<!--  有圖片時：顯示圖片 + 右上角換圖按鈕  -->
				<Border
                    Background="{DynamicResource MaterialPaperColor}"
                    BorderBrush="{DynamicResource MaterialDividerBrush}"
                    BorderThickness="2"
                    ClipToBounds="True"
                    CornerRadius="16"
                    IsVisible="{Binding HasFile}">
					<Panel>
						<Image
                            Name="PreviewImage"
                            Cursor="Hand"
                            DoubleTapped="OnImageDoubleTapped"
                            Source="{Binding FileImage}"
                            Stretch="UniformToFill"
                            ToolTip.Tip="雙擊放大" />

						<!--  換圖按鈕  -->
						<Button
                            Width="32"
                            Height="32"
                            Margin="0,8,8,0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#80000000"
                            BorderThickness="0"
                            Classes="flat"
                            Click="OnSelectFileClick"
                            CornerRadius="16"
                            ToolTip.Tip="更換圖片">
							<avalonia:MaterialIcon
                                Width="18"
                                Height="18"
                                Foreground="White"
                                Kind="Pencil" />
						</Button>
					</Panel>
				</Border>

				<!--  沒圖片時：顯示上傳按鈕  -->
				<Button
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource MaterialPaperColor}"
                    BorderBrush="{DynamicResource MaterialDividerBrush}"
                    BorderThickness="2"
                    Classes="flat"
                    Click="OnSelectFileClick"
                    CornerRadius="16"
                    IsVisible="{Binding NotHasFile}">
					<StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.4">
						<avalonia:MaterialIcon
                            Width="48"
                            Height="48"
                            Foreground="{DynamicResource MaterialSecondaryForegroundBrush}"
                            Kind="Add" />
						<TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource MaterialSecondaryForegroundBrush}"
                            Text="上傳圖片" />
					</StackPanel>
				</Button>
			</Panel>

			<StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="12">
				<Button
                    MinWidth="110"
                    Classes="Outlined"
                    Command="{Binding CancelCommand}">
					取消
				</Button>
				<Button
                    MinWidth="110"
                    Background="{DynamicResource MaterialPrimaryColor}"
                    Command="{Binding ConfirmCommand}"
                    Foreground="{DynamicResource MaterialOnPrimaryColor}">
					確認
				</Button>
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>