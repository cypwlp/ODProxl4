<UserControl
    x:Class="ODProxl.RevisionDetailsDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="400"
    d:DesignWidth="400"
    mc:Ignorable="d">
	<Border Padding="20" Background="{DynamicResource MaterialCardBackgroundBrush}">
		<StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
			<TextBox
                Width="300"
                Text="{Binding AttrName}"
                Watermark="屬性名稱" />
			<TextBox
                Width="300"
                Text="{Binding AttrValue}"
                Watermark="屬性值" />
			<TextBox
                Width="300"
                Text="{Binding AttrUnit}"
                Watermark="單位" />
			<TextBox
                Width="300"
                Text="{Binding ClassId}"
                Watermark="ClassId" />
			<StackPanel
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
				<Button Command="{Binding CloseCommand}" CommandParameter="true">確定</Button>
				<Button Command="{Binding CloseCommand}" CommandParameter="false">取消</Button>
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>