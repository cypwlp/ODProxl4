<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignWidth="560" 
             d:DesignHeight="420"
             x:Class="ODProxl.Dialogs.AddOrEditProductDialog">
    <Border Background="{DynamicResource MaterialCardBackgroundBrush}"
            CornerRadius="12"
            Padding="24"
            MinWidth="520"
            MaxWidth="580">

        <StackPanel Spacing="20">

            <!-- 標題 -->
            <TextBlock Text="{Binding Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource MaterialPrimaryBrush}" />

            <!-- 表單內容 -->
            <StackPanel Spacing="16">

                <!-- 產品代碼 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="產品代碼 *" 
                               FontWeight="Medium"
                               FontSize="13"/>
                    <TextBox Text="{Binding CurrentProduct.ProductCode}"
                             Watermark="例如：PROD-001"
                             FontSize="14"
                             Height="42"/>
                </StackPanel>

                <!-- 產品名稱 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="產品名稱 *" 
                               FontWeight="Medium"
                               FontSize="13"/>
                    <TextBox Text="{Binding CurrentProduct.ProductName}"
                             Watermark="輸入產品完整名稱"
                             FontSize="14"
                             Height="42"/>
                </StackPanel>

                <!-- 描述 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="描述" 
                               FontWeight="Medium"
                               FontSize="13"/>
                    <TextBox Text="{Binding CurrentProduct.Description}"
                             Watermark="產品詳細描述（選填）"
                             Height="100"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontSize="14"/>
                </StackPanel>

                <!-- 啟用狀態 -->
                <CheckBox Content="啟用此產品"
                          IsChecked="{Binding CurrentProduct.IsActive}"
                          FontSize="14"
                          Margin="0,8,0,0"/>

            </StackPanel>

            <!-- 分隔線 -->
            <Separator Background="{DynamicResource MaterialDividerBrush}" Height="1" Margin="0,8"/>

            <!-- 按鈕區域 -->
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right"
                        Spacing="12">

                <Button Command="{Binding CancelCommand}"
                        Classes="Outlined"
                        Width="110"
                        Height="42"
                        Content="取消"/>

                <Button Command="{Binding SaveCommand}"
                        Classes="Filled"
                        Width="110"
                        Height="42"
                        Content="儲存"/>

            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>