<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:ODProxl.ViewModels.Pages;assembly=ODProxl.ViewModels"
             x:DataType="vm:OnnxModelPageViewModel"
             xmlns:icbtn="using:ODProxl.ExtendControls"
             x:Class="ODProxl.Pages.OnnxModelPage">
	<Border Background="{DynamicResource MaterialCardBackgroundBrush}"
			CornerRadius="12"
			Margin="12"
			BoxShadow="0 8 24 0 #20000000">
		<Grid RowDefinitions="Auto,Auto,*">
			<StackPanel Grid.Row="0" Margin="24,20,24,16" Orientation="Horizontal">  
				<TextBox Name="SearchBox"
						 DockPanel.Dock="Left"
						 HorizontalAlignment="Left"
						 Width="340"
						 Watermark="搜尋模型名稱..."
						 Text="{Binding SearchText}"
						 KeyDown="Search_OnKeyDown"
						 CornerRadius="24"
						 Classes="solo">
					<TextBox.InnerLeftContent>
						<avalonia:MaterialIcon Kind="Magnify"
											   Width="20" Height="20"
											   Margin="14,0,0,0"
											   Foreground="{DynamicResource MaterialForegroundBrush}"/>
					</TextBox.InnerLeftContent>
					<TextBox.InnerRightContent>
						<Button Name="SearchButton"
								Width="38" Height="38"
								CornerRadius="19"
								Classes="flat"
								Command="{Binding SearchCommand}"
								CommandParameter="{Binding SearchText}">
							<avalonia:MaterialIcon Kind="ArrowRight" Width="20" Height="20"/>
						</Button>
					</TextBox.InnerRightContent>
				</TextBox>
				<icbtn:IconActionButton IconKind="ShapePlusOutline"
										Width="38"
										Height="38"
										ToolTipText="新增預訓練模型"
										SnackbarMessage="正在新增預訓練模型..."
										SnackbarType="Information"
										Command="{Binding CreatePreTrainedModelCommand}"
										Margin="20,0,0,0"/>
			</StackPanel>

			<DataGrid Grid.Row="2"
					  Margin="12,0,12,16"
					  ItemsSource="{Binding UserModels}"
					  CanUserResizeColumns="True"
					  CanUserReorderColumns="False"
					  GridLinesVisibility="None"
					  BorderThickness="0"
					  Background="Transparent"
					  SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
					  RowBackground="{DynamicResource MaterialCardBackgroundBrush}">
				<DataGrid.Columns>
					<DataGridTextColumn Header="序號"
					                    Binding="{Binding RowIndex }"
					                    Width="70"
					                    IsReadOnly="True"/>
					<DataGridTextColumn Header="模型ID"
					                    Binding="{Binding ModelId}"
					                    Width="70"
					                    IsReadOnly="True"/>
					<DataGridTextColumn Header="模型名稱"
										Binding="{Binding ModelName}"
										Width="*"
										IsReadOnly="True"/>
					<DataGridTextColumn Header="大小"
										Binding="{Binding SizeDisplay}"
										Width="140"
										IsReadOnly="True">
						<DataGridTextColumn.HeaderTemplate>
							<DataTemplate>
								<TextBlock Text="大小" HorizontalAlignment="Right" FontWeight="SemiBold"/>
							</DataTemplate>
						</DataGridTextColumn.HeaderTemplate>
					</DataGridTextColumn>
					<DataGridTextColumn Header="建立時間"
										Binding="{Binding CreatedTimeDisplay}"
										Width="170"
										IsReadOnly="True"/>
					<DataGridTemplateColumn Header="物理狀態" Width="120">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<ToggleSwitch IsChecked="{Binding IsExist, Mode=TwoWay}"
											  OffContent="待訓練"
											  OnContent="已存在"
											  Width="96"
											  Classes="Material"
											  HorizontalAlignment="Center"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTemplateColumn Header="邏輯狀態" Width="120">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}"
											  OffContent="已停用"
											  OnContent="已啟用"
											  Width="96"
											  Classes="Material"
											  HorizontalAlignment="Center"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTemplateColumn Header="操作" Width="100">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Button Content="詳情"
								        Classes="flat"
								        HorizontalAlignment="Center"
								        Command="{Binding DataContext.OpenSubClassPageCommand,
                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
								        CommandParameter="{Binding}"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>

			<Border Grid.Row="2"
					IsVisible="{Binding IsLoading}"
					Background="#80000000"
					CornerRadius="12">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
					<ProgressBar Width="200" IsIndeterminate="True"/>
					<TextBlock Text="正在載入模型列表..."
							   Foreground="White"
							   FontSize="15"/>
				</StackPanel>
			</Border>
		</Grid>
	</Border>
</UserControl>
