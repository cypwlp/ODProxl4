<UserControl
    x:Class="ODProxl.Pages.UserConfigPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:et="clr-namespace:ODProxl.ExtendControls;assembly=ODProxl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
	<et:PageContainer>

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!--  底部按鈕區域  -->
			<Border
                Grid.Row="1"
                Margin="32,20,32,32"
                Padding="0,20,0,0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                CornerRadius="20">
				<StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="15">
					<Button
                        MinWidth="120"
                        Content="取消"
                        Theme="{DynamicResource MaterialOutlinedButton}" />
					<Button
                        MinWidth="140"
                        Command="{Binding SaveCommandAsync}"
                        Content="儲存變更"
                        IsEnabled="{Binding CanSave, Mode=OneWay}"
                        Theme="{DynamicResource MaterialFilledButton}" />
				</StackPanel>
			</Border>

			<!--  內容區域  -->
			<ScrollViewer
                Grid.Row="0"
                Padding="32,24,32,24"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

				<StackPanel
                    MaxWidth="920"
                    HorizontalAlignment="Stretch"
                    Spacing="40">

					<!--  外觀區塊  -->
					<Border
                        Padding="28"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BoxShadow="0 4 16 0 #1F000000"
                        Classes="Card"
                        CornerRadius="16">
						<StackPanel Spacing="24">
							<StackPanel Orientation="Horizontal" Spacing="16">
								<avalonia:MaterialIcon
                                    Width="32"
                                    Height="32"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Kind="Palette" />
								<StackPanel Spacing="4">
									<TextBlock Classes="Headline6" Text="外觀" />
									<TextBlock
                                        Classes="Body2"
                                        Opacity="0.7"
                                        Text="主題、顏色與語言" />
								</StackPanel>
							</StackPanel>
							<Separator />
							<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
								<TextBlock
                                    Grid.Row="0"
                                    VerticalAlignment="Center"
                                    Classes="Body1"
                                    Text="應用程式主題" />
								<ComboBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="{OnFormFactor Desktop=240,
                                                         Mobile=200}"
                                    SelectedIndex="0">
									<ComboBoxItem>跟隨系統</ComboBoxItem>
									<ComboBoxItem>淺色</ComboBoxItem>
									<ComboBoxItem>深色</ComboBoxItem>
								</ComboBox>
								<TextBlock
                                    Grid.Row="1"
                                    Margin="0,20,0,0"
                                    VerticalAlignment="Center"
                                    Classes="Body1"
                                    Text="語言" />
								<ComboBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Width="{OnFormFactor Desktop=240,
                                                         Mobile=200}"
                                    Margin="0,20,0,0">
									<ComboBoxItem>繁體中文 (台灣)</ComboBoxItem>
									<ComboBoxItem>繁體中文 (香港)</ComboBoxItem>
									<ComboBoxItem>English</ComboBoxItem>
									<ComboBoxItem>简体中文</ComboBoxItem>
								</ComboBox>
								<TextBlock
                                    Grid.Row="2"
                                    Margin="0,20,0,0"
                                    VerticalAlignment="Center"
                                    Classes="Body1"
                                    Text="啟用平滑動畫" />
								<ToggleSwitch
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,20,0,0"
                                    IsChecked="True" />
							</Grid>
						</StackPanel>
					</Border>

					<!--  通知區塊  -->
					<Border
                        Padding="28"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BoxShadow="0 4 16 0 #1F000000"
                        Classes="Card"
                        CornerRadius="16">
						<StackPanel Spacing="24">
							<StackPanel Orientation="Horizontal" Spacing="16">
								<avalonia:MaterialIcon
                                    Width="32"
                                    Height="32"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Kind="Notifications" />
								<StackPanel Spacing="4">
									<TextBlock Classes="Headline6" Text="通知" />
									<TextBlock
                                        Classes="Body2"
                                        Opacity="0.7"
                                        Text="接收更新與提醒" />
								</StackPanel>
							</StackPanel>
							<Separator />
							<StackPanel Spacing="12">
								<CheckBox Content="啟用桌面通知" IsChecked="True" />
								<CheckBox Content="接收系統更新通知" IsChecked="True" />
								<CheckBox Content="顯示每日提示" IsChecked="False" />
							</StackPanel>
						</StackPanel>
					</Border>

					<!--  開發者設定區塊  -->
					<Border
                        Background="Transparent"
                        BoxShadow="0 4 16 0 #1F000000"
                        CornerRadius="16"
                        IsVisible="{Binding IsDeveloperMode, Mode=OneWay}">
						<Border
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            ClipToBounds="True"
                            CornerRadius="16">
							<Border Padding="28,28,28,44">
								<StackPanel Spacing="24">
									<StackPanel Orientation="Horizontal" Spacing="16">
										<avalonia:MaterialIcon
                                            Width="32"
                                            Height="32"
                                            Foreground="{DynamicResource ErrorBrush}"
                                            Kind="CodeTags" />
										<StackPanel
                                            HorizontalAlignment="Center"
                                            Orientation="Vertical"
                                            Spacing="4">
											<TextBlock
                                                Classes="Headline6"
                                                Foreground="{DynamicResource ErrorBrush}"
                                                Text="開發者設定" />
											<TextBlock
                                                Classes="Body2"
                                                Opacity="0.7"
                                                Text="開發者配置項" />

										</StackPanel>
										<StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
											<et:IconActionButton
                                                Height="40"
                                                Command="{Binding AddDeveloperSettingCommand}"
                                                IconKind="AddAlert"
                                                Text="新增" />
											<et:IconActionButton
                                                Height="40"
                                                Margin="10,0,0,0"
                                                Command="{Binding EditDeveloperSettingCommand}"
                                                IconKind="Edit"
                                                Text="修改" />
										</StackPanel>
									</StackPanel>
									<Separator />
									<Grid Margin="0">
										<DataGrid
                                            AutoGenerateColumns="False"
                                            Background="{DynamicResource MaterialCardBackgroundBrush}"
                                            CanUserReorderColumns="False"
                                            GridLinesVisibility="Horizontal"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding Products}"
                                            RowBackground="{DynamicResource MaterialCardBackgroundBrush}">

											<DataGrid.Columns>
												<DataGridTextColumn
                                                    Width="*"
                                                    Binding="{Binding CgType}"
                                                    Header="類型" />

												<DataGridTextColumn
                                                    Width="*"
                                                    Binding="{Binding CgModuleName}"
                                                    Header="配置名稱" />

												<DataGridTextColumn
                                                    Width="2*"
                                                    Binding="{Binding CgKey}"
                                                    Header="配置鍵名" />

												<DataGridCheckBoxColumn
                                                    Width="100"
                                                    Binding="{Binding CgValue}"
                                                    Header="配置值" />
											</DataGrid.Columns>
										</DataGrid>
									</Grid>
									<Rectangle Height="8" Fill="Transparent" />
								</StackPanel>
							</Border>
						</Border>
					</Border>

					<Rectangle Height="64" Fill="Transparent" />
				</StackPanel>
			</ScrollViewer>
		</Grid>
	</et:PageContainer>
</UserControl>
