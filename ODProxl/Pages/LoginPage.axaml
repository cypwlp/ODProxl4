<UserControl
    x:Class="ODProxl.Pages.LoginPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:ODProxl.ViewModels.Pages;assembly=ODProxl.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="800"
    x:DataType="vm:LoginPageViewModel"
    mc:Ignorable="d">

	<Grid Background="#F8FAFC">
		<!--  背景裝飾圓形  -->
		<Canvas IsHitTestVisible="False">
			<Ellipse
                Canvas.Left="-80"
                Canvas.Top="-60"
                Width="220"
                Height="220"
                Fill="#4F46E5"
                Opacity="0.06" />
			<Ellipse
                Canvas.Right="-80"
                Canvas.Bottom="-80"
                Width="280"
                Height="280"
                Fill="#10B981"
                Opacity="0.05" />
			<Ellipse
                Canvas.Left="320"
                Canvas.Top="380"
                Width="180"
                Height="180"
                Fill="#6366F1"
                Opacity="0.04" />
		</Canvas>

		<!--  主要登入卡片  -->
		<Border
            Width="420"
            Height="580"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            BoxShadow="0 20 40 0 #1E293B20"
            ClipToBounds="True"
            CornerRadius="20">

			<Grid Margin="48,48,48,48" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

				<!--  標題區域  -->
				<StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,36"
                    HorizontalAlignment="Center"
                    Spacing="12">
					<Border
                        Width="72"
                        Height="72"
                        Margin="0,0,0,8"
                        Background="#4F46E5"
                        CornerRadius="36" />
					<TextBlock
                        HorizontalAlignment="Center"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="#1E293B"
                        Text="拓脈匙標準檢測系統" />
					<TextBlock
                        HorizontalAlignment="Center"
                        FontSize="14.5"
                        Foreground="#64748B"
                        Text="請輸入您的憑證以繼續" />
				</StackPanel>

				<!--  用戶名  -->
				<StackPanel
                    Grid.Row="1"
                    Margin="0,0,0,20"
                    Spacing="6">
					<TextBlock
                        FontSize="13.5"
                        FontWeight="Medium"
                        Foreground="#475569"
                        Text="用戶名" />
					<Border
                        Padding="3"
                        Background="#F8FAFC"
                        CornerRadius="10">
						<TextBox
                            x:Name="UserNameTextBox"
                            Padding="16,13"
                            Background="Transparent"
                            BorderThickness="1"
                            CornerRadius="8"
                            FontSize="15"
                            KeyDown="UserNameTextBox_KeyDown"
                            Text="{Binding UserName, Mode=TwoWay}">
							<TextBox.Styles>
								<Style Selector="TextBox:focus">
									<Setter Property="BorderBrush" Value="#4F46E5" />
									<Setter Property="Background" Value="White" />
								</Style>
							</TextBox.Styles>
						</TextBox>
					</Border>
				</StackPanel>

				<!--  密碼  -->
				<StackPanel
                    Grid.Row="2"
                    Margin="0,0,0,20"
                    Spacing="6">
					<Grid>
						<TextBlock
                            FontSize="13.5"
                            FontWeight="Medium"
                            Foreground="#475569"
                            Text="密碼" />
						<TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            FontSize="13"
                            Foreground="#4F46E5"
                            Text="忘記密碼？" />
					</Grid>
					<Border
                        Padding="3"
                        Background="#F8FAFC"
                        CornerRadius="10">
						<TextBox
                            x:Name="PasswordTextBox"
                            Padding="16,13"
                            Background="Transparent"
                            BorderThickness="1"
                            CornerRadius="8"
                            FontSize="15"
                            KeyDown="PasswordTextBox_KeyDown"
                            PasswordChar="*"
                            Text="{Binding Password, Mode=TwoWay}">
							<TextBox.Styles>
								<Style Selector="TextBox:focus">
									<Setter Property="BorderBrush" Value="#4F46E5" />
									<Setter Property="Background" Value="White" />
								</Style>
							</TextBox.Styles>
						</TextBox>
					</Border>
				</StackPanel>

				<!--  記住我  -->
				<CheckBox
                    Grid.Row="3"
                    Margin="0,4,0,12"
                    Content="記住我"
                    FontSize="14"
                    Foreground="#64748B" />

				<!--  登錄按鈕  -->
				<Button
                    Grid.Row="4"
                    Height="52"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    Background="#4F46E5"
                    Command="{Binding LoginCommand}"
                    Content="登錄"
                    CornerRadius="10"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="White" />
			</Grid>
		</Border>
	</Grid>
</UserControl>