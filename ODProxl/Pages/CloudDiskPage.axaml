<UserControl
    x:Class="ODProxl.CloudDiskPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:et="clr-namespace:ODProxl.ExtendControls;assembly=ODProxl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
	<et:PageContainer>
		<Border>

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0" Orientation="Horizontal">

					<TextBox
                        Name="SearchBox"
                        Width="340"
                        HorizontalAlignment="Left"
                        Classes="solo"
                        CornerRadius="24"
                        Text="{Binding SearchText}"
                        Watermark="搜尋文件...">
						<TextBox.InnerLeftContent>
							<avalonia:MaterialIcon
                                Width="20"
                                Height="20"
                                Margin="14,0,0,0"
                                Foreground="{DynamicResource MaterialForegroundBrush}"
                                Kind="Magnify" />
						</TextBox.InnerLeftContent>
						<TextBox.InnerRightContent>
							<Button
                                Name="SearchButton"
                                Width="38"
                                Height="38"
                                Classes="flat"
                                Command="{Binding SearchCommand}"
                                CommandParameter="{Binding SearchText}"
                                CornerRadius="19">
								<avalonia:MaterialIcon
                                    Width="20"
                                    Height="20"
                                    Kind="ArrowRight" />
							</Button>
						</TextBox.InnerRightContent>
					</TextBox>
					<et:IconActionButton
                        Width="38"
                        Height="38"
                        Margin="20,0,0,0"
                        Command="{Binding CreateFloder}"
                        IconKind="ShapePlusOutline"
                        SnackbarType="Information"
                        ToolTipText="新增文件夾" />
				</StackPanel>

				<StackPanel Grid.Row="1">
					<DataGrid />
				</StackPanel>
			</Grid>
		</Border>
	</et:PageContainer>
</UserControl>
